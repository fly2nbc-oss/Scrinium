{
  "name": "tesseract",
  "version": "5.5.3",
  "description": "Tesseract OCR (overlay: no curl, no libarchive, no legacy engine, no ScrollView)",
  "homepage": "https://github.com/tesseract-ocr/tesseract",
  "license": "Apache-2.0",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "cpu-features",
      "platform": "android"
    },
    "leptonica",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "training-tools": {
      "description": "build training tools",
      "dependencies": [
        "cairo",
        "fontconfig",
        "icu",
        "pango"
      ]
    }
  },
  "port-version": 101
}
